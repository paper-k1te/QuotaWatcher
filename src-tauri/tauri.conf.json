{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "QuotaWatcher",
  "version": "0.1.0",
  "identifier": "com.quotawatcher.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuotaWatcher - 全平台多账号额度管家",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
